<Window x:Class="DeviceFinder.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="{DynamicResource S.Ui.MainTitle}"
        Icon="pack://application:,,,/Resources/app.ico"
        Height="760" Width="1280" MinHeight="560" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded" Closing="Window_Closing">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Carte réseau à surveiller + bascule de langue -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="{DynamicResource S.Ui.AdapterLabel}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <Button x:Name="RefreshAdaptersButton" DockPanel.Dock="Right" Content="{DynamicResource S.Ui.Refresh}"
                    Padding="14,3" Margin="8,0,0,0" Click="RefreshAdaptersButton_Click"/>
            <DockPanel DockPanel.Dock="Right" Margin="8,0,0,0">
                <ComboBox x:Name="LanguageCombo" Width="95" VerticalAlignment="Center"
                          SelectionChanged="LanguageCombo_SelectionChanged">
                    <ComboBoxItem Content="Français" Tag="fr-FR"/>
                    <ComboBoxItem Content="English" Tag="en-US"/>
                </ComboBox>
                <TextBlock Text="{DynamicResource S.Ui.LanguageLabel}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            </DockPanel>
            <ComboBox x:Name="AdapterCombo" MinWidth="380"
                      SelectionChanged="AdapterCombo_SelectionChanged"/>
        </DockPanel>

        <!-- Bandeaux d'avertissement (empilés, jamais superposés) -->
        <StackPanel Grid.Row="1" Margin="0,0,0,8">
            <!-- Bandeau Npcap -->
            <Border x:Name="NpcapStatusBorder" Margin="0,0,0,4"
                    Background="#FFF8E1" BorderBrush="#E6A817" BorderThickness="1"
                    CornerRadius="4" Padding="8,5" Visibility="Collapsed">
                <DockPanel>
                    <Button x:Name="InstallNpcapButton" DockPanel.Dock="Right"
                            Content="{DynamicResource S.Ui.InstallNpcap}"
                            Padding="12,3" Margin="8,0,0,0" Click="InstallNpcapButton_Click"/>
                    <TextBlock x:Name="NpcapStatusText" TextWrapping="Wrap" VerticalAlignment="Center"
                               Text="{DynamicResource S.Npcap.Banner}"/>
                </DockPanel>
            </Border>

            <!-- Bandeau serveur DHCP actif (avertissement permanent tant qu'il tourne) -->
            <Border x:Name="DhcpActiveBorder" Margin="0,0,0,4"
                    Background="#FDEBD0" BorderBrush="#E67E22" BorderThickness="1"
                    CornerRadius="4" Padding="8,5" Visibility="Collapsed">
                <DockPanel>
                    <Button x:Name="DhcpDisableButton" DockPanel.Dock="Right"
                            Content="{DynamicResource S.Ui.DisableDhcp}"
                            Padding="12,3" Margin="8,0,0,0" Click="DhcpDisableButton_Click"/>
                    <TextBlock x:Name="DhcpActiveText" TextWrapping="Wrap" VerticalAlignment="Center"
                               FontWeight="Bold"/>
                </DockPanel>
            </Border>

            <!-- Bandeau résidus de session précédente -->
            <Border x:Name="ResidualAliasesBorder"
                    Background="#FDE7E7" BorderBrush="#C0392B" BorderThickness="1"
                    CornerRadius="4" Padding="8,5" Visibility="Collapsed">
                <DockPanel>
                    <Button x:Name="CleanResidualButton" DockPanel.Dock="Right"
                            Content="{DynamicResource S.Ui.RemoveAliases}"
                            Padding="12,3" Margin="8,0,0,0" Click="CleanResidualButton_Click"/>
                    <TextBlock x:Name="ResidualAliasesText" TextWrapping="Wrap" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>
        </StackPanel>

        <!-- Zone principale : onglets Détection / Navigateur -->
        <TabControl x:Name="MainTabs" Grid.Row="2">

            <!-- ============================ Détection ============================ -->
            <TabItem Header="{DynamicResource S.Ui.TabDetection}">
                <Grid Margin="8,8,8,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="330"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Liste des devices -->
                    <ListView x:Name="DeviceListView" Grid.Row="0" Grid.Column="0"
                              SelectionMode="Single"
                              MouseDoubleClick="DeviceListView_MouseDoubleClick"
                              KeyDown="DeviceListView_KeyDown"
                              SelectionChanged="DeviceListView_SelectionChanged"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="{DynamicResource S.Ui.ColMac}" Width="160">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Mac}" FontWeight="Bold"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="{DynamicResource S.Ui.ColVendor}" Width="210">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Vendor}" TextTrimming="CharacterEllipsis"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="{DynamicResource S.Ui.ColIpDetected}" Width="120">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding IpDisplay}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="{DynamicResource S.Ui.ColMode}" Width="80">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding ModeDisplay}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="{DynamicResource S.Ui.ColStatus}" Width="110">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="10" Height="10" Fill="{Binding StatusBrush}"/>
                                                <TextBlock Text="{Binding StatusText}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="{DynamicResource S.Ui.ColLastSeen}" Width="100">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding LastSeenText}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <!-- Actions sur le device sélectionné -->
                    <WrapPanel Grid.Row="1" Grid.Column="0" Margin="0,8,0,0">
                        <Button x:Name="OpenWebButton" Content="{DynamicResource S.Ui.OpenWeb}" Padding="12,5"
                                Margin="0,0,8,0" Click="OpenWebButton_Click" IsEnabled="False"/>
                        <Button x:Name="OpenExternalButton" Content="{DynamicResource S.Ui.OpenExternal}" Padding="12,5"
                                Margin="0,0,8,0" Click="OpenExternalButton_Click" IsEnabled="False"/>
                        <Button x:Name="CopyMacButton" Content="{DynamicResource S.Ui.CopyMac}" Padding="12,5"
                                Margin="0,0,8,0" Click="CopyMacButton_Click" IsEnabled="False"/>
                        <Button x:Name="CopyIpButton" Content="{DynamicResource S.Ui.CopyIp}" Padding="12,5"
                                Margin="0,0,8,0" Click="CopyIpButton_Click" IsEnabled="False"/>
                        <Button x:Name="RestoreNetworkButton" Content="{DynamicResource S.Ui.RestoreNetwork}" Padding="12,5"
                                Margin="0,0,8,0" Click="RestoreNetworkButton_Click"/>
                    </WrapPanel>

                    <!-- Mode IP manuelle : utilisable sans Npcap -->
                    <GroupBox Grid.Row="2" Grid.Column="0" Margin="0,10,0,0"
                              Header="{DynamicResource S.Ui.ManualGroup}">
                        <StackPanel>
                            <DockPanel Margin="0,2,0,4">
                                <Button x:Name="ManualProbeButton" DockPanel.Dock="Right"
                                        Content="{DynamicResource S.Ui.Probe}" Padding="14,3"
                                        Margin="8,0,0,0" Click="ManualProbeButton_Click"/>
                                <TextBlock Text="{DynamicResource S.Ui.ManualLabel}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox x:Name="ManualIpBox" Width="230" VerticalAlignment="Center"
                                         KeyDown="ManualIpBox_KeyDown"/>
                                <TextBlock Foreground="#888888" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap"
                                           Text="{DynamicResource S.Ui.ManualHint}"/>
                            </DockPanel>
                            <ListView x:Name="ManualResultsView" Height="110"
                                      MouseDoubleClick="ManualResultsView_MouseDoubleClick"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="IP" Width="130">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Ip}" FontWeight="Bold"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="{DynamicResource S.Ui.ColMac}" Width="160">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Mac}"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="{DynamicResource S.Ui.ColVendor}" Width="230">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Vendor}" TextTrimming="CharacterEllipsis"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="{DynamicResource S.Ui.ColStatus}" Width="140">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Status}"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </StackPanel>
                    </GroupBox>

                    <!-- Panneau de détail du device sélectionné -->
                    <GroupBox Grid.Row="0" Grid.RowSpan="4" Grid.Column="2" Margin="8,0,0,0"
                              Header="{DynamicResource S.Ui.DetailGroup}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock x:Name="DetailMac" Text="—" FontSize="16" FontWeight="Bold"
                                           Margin="0,4,0,2" TextWrapping="Wrap"/>
                                <TextBlock x:Name="DetailVendor" Foreground="#555555" Margin="0,0,0,8"
                                           TextWrapping="Wrap"/>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{DynamicResource S.Ui.DetailIpLabel}" Margin="0,0,8,2"/>
                                    <TextBlock x:Name="DetailIp" Grid.Column="1" FontWeight="Bold"/>
                                    <TextBlock Text="{DynamicResource S.Ui.DetailModeLabel}" Grid.Row="1" Margin="0,0,8,2"/>
                                    <TextBlock x:Name="DetailMode" Grid.Row="1" Grid.Column="1"/>
                                    <TextBlock Text="{DynamicResource S.Ui.DetailStatusLabel}" Grid.Row="2" Margin="0,0,8,2"/>
                                    <TextBlock x:Name="DetailStatus" Grid.Row="2" Grid.Column="1"/>
                                    <TextBlock Text="{DynamicResource S.Ui.DetailFirstSeenLabel}" Grid.Row="3" Margin="0,0,8,2"/>
                                    <TextBlock x:Name="DetailFirstSeen" Grid.Row="3" Grid.Column="1"/>
                                    <TextBlock Text="{DynamicResource S.Ui.DetailLastSeenLabel}" Grid.Row="4" Margin="0,0,8,2"/>
                                    <TextBlock x:Name="DetailLastSeen" Grid.Row="4" Grid.Column="1"/>
                                    <TextBlock Text="{DynamicResource S.Ui.DetailAliasLabel}" Grid.Row="5" Margin="0,0,8,2"/>
                                    <TextBlock x:Name="DetailAlias" Grid.Row="5" Grid.Column="1"/>
                                </Grid>

                                <TextBlock Text="{DynamicResource S.Ui.DetailHistoryLabel}" FontWeight="Bold" Margin="0,10,0,4"/>
                                <ListView x:Name="DetailHistoryView" MaxHeight="140"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="IP" Width="130">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}"/>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                                <TextBlock x:Name="DetailHistoryEmpty"
                                           Text="{DynamicResource S.Ui.DetailHistoryEmpty}"
                                           Foreground="#888888" Margin="0,4,0,0"/>

                                <Separator Margin="0,12,0,10"/>
                                <TextBlock Text="{DynamicResource S.Ui.DetailWebLabel}" FontWeight="Bold" Margin="0,0,0,6"/>
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Text="{DynamicResource S.Ui.ProtocolLabel}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="ProtocolCombo" Width="90" VerticalAlignment="Center"
                              SelectionChanged="ProtocolCombo_SelectionChanged">
                                        <ComboBoxItem Content="http" IsSelected="True"/>
                                        <ComboBoxItem Content="https"/>
                                    </ComboBox>
                                    <TextBlock Text="{DynamicResource S.Ui.PortLabel}" VerticalAlignment="Center" Margin="14,0,8,0"/>
                                    <ComboBox x:Name="PortCombo" Width="90" IsEditable="True" VerticalAlignment="Center"
                                              KeyDown="PortCombo_KeyDown" LostFocus="PortCombo_LostFocus">
                                        <ComboBoxItem Content="80" IsSelected="True"/>
                                        <ComboBoxItem Content="443"/>
                                        <ComboBoxItem Content="8000"/>
                                        <ComboBoxItem Content="8080"/>
                                        <ComboBoxItem Content="8081"/>
                                        <ComboBoxItem Content="8443"/>
                                    </ComboBox>
                                </DockPanel>
                                <TextBlock x:Name="DetailUrlPreview" Foreground="#555555" TextWrapping="Wrap"
                                           Text="http://—/"/>
                            </StackPanel>
                        </ScrollViewer>
                    </GroupBox>

                    <!-- Mini-serveur DHCP : attribue une IP aux équipements en attente DHCP -->
                    <GroupBox Grid.Row="3" Grid.Column="0" Margin="0,10,0,0"
                              Header="{DynamicResource S.Ui.DhcpGroup}">
                        <StackPanel>
                            <DockPanel Margin="0,2,0,4">
                                <Button x:Name="DhcpApplyButton" DockPanel.Dock="Right"
                                        Content="{DynamicResource S.Ui.Apply}"
                                        Padding="12,3" Margin="8,0,0,0" Click="DhcpApplyButton_Click"/>
                                <CheckBox x:Name="DhcpEnabledCheck" VerticalAlignment="Center"
                                          Content="{DynamicResource S.Ui.DhcpActiveCheck}"
                                          Checked="DhcpEnabledCheck_Changed" Unchecked="DhcpEnabledCheck_Changed"/>
                            </DockPanel>
                            <WrapPanel Margin="0,0,0,4">
                                <TextBlock Text="{DynamicResource S.Ui.DhcpPoolStart}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox x:Name="DhcpPoolStartBox" Width="115" VerticalAlignment="Center"
                                         KeyDown="DhcpConfigBox_KeyDown" LostFocus="DhcpConfigBox_LostFocus"/>
                                <TextBlock Text="{DynamicResource S.Ui.DhcpPoolEnd}" VerticalAlignment="Center" Margin="12,0,6,0"/>
                                <TextBox x:Name="DhcpPoolEndBox" Width="115" VerticalAlignment="Center"
                                         KeyDown="DhcpConfigBox_KeyDown" LostFocus="DhcpConfigBox_LostFocus"/>
                                <TextBlock Text="{DynamicResource S.Ui.DhcpServerIp}" VerticalAlignment="Center"
                                           Margin="12,0,6,0"/>
                                <TextBox x:Name="DhcpServerIpBox" Width="115" VerticalAlignment="Center"
                                         KeyDown="DhcpConfigBox_KeyDown" LostFocus="DhcpConfigBox_LostFocus"/>
                                <TextBlock Text="{DynamicResource S.Ui.DhcpLease}" VerticalAlignment="Center"
                                           Margin="12,0,6,0"/>
                                <ComboBox x:Name="DhcpLeaseCombo" Width="80" VerticalAlignment="Center"
                                          SelectionChanged="DhcpLeaseCombo_SelectionChanged">
                                    <ComboBoxItem Content="5 min" Tag="300"/>
                                    <ComboBoxItem Content="10 min" Tag="600"/>
                                    <ComboBoxItem Content="1 h" Tag="3600"/>
                                    <ComboBoxItem Content="12 h" Tag="43200"/>
                                    <ComboBoxItem Content="24 h" Tag="86400"/>
                                </ComboBox>
                                <Button x:Name="LeaseHelpButton" Content="ⓘ" Width="28" Height="28"
                                        Margin="6,0,0,0" Padding="0" FontSize="14" FontWeight="Bold"
                                        Foreground="#E67E22" BorderBrush="#E67E22" Background="Transparent"
                                        Cursor="Hand" Click="LeaseHelpButton_Click"
                                        ToolTip="{DynamicResource S.Ui.LeaseHelpToolTip}"/>
                            </WrapPanel>
                            <TextBlock Foreground="#888888" TextWrapping="Wrap"
                                       Text="{DynamicResource S.Ui.DhcpHint}"/>
                            <ListView x:Name="DhcpLeasesView" Height="86" Margin="0,4,0,0"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="{DynamicResource S.Ui.ColMac}" Width="150">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Mac}" FontWeight="Bold"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="{DynamicResource S.Ui.ColIpAssigned}" Width="120">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Ip}"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="{DynamicResource S.Ui.ColStatus}" Width="100">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding State}"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="{DynamicResource S.Ui.ColExpires}" Width="90">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Expires}"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </StackPanel>
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- ============================ Navigateur ============================ -->
            <TabItem Header="{DynamicResource S.Ui.TabBrowser}">
                <DockPanel Margin="8,8,8,4">
                    <ToolBarTray DockPanel.Dock="Top" IsLocked="True">
                        <ToolBar Band="0" BandIndex="0">
                            <Button x:Name="BrowserBackButton" Content="←" Width="32" Click="BrowserBackButton_Click"/>
                            <Button x:Name="BrowserForwardButton" Content="→" Width="32" Click="BrowserForwardButton_Click"/>
                            <Button x:Name="BrowserReloadButton" Content="{DynamicResource S.Ui.Reload}" Padding="10,3" Click="BrowserReloadButton_Click"/>
                            <Separator/>
                            <TextBox x:Name="AddressBox" Width="420" KeyDown="AddressBox_KeyDown"/>
                            <Button x:Name="AddressGoButton" Content="{DynamicResource S.Ui.Go}" Padding="10,3" Click="AddressGoButton_Click"/>
                            <Separator/>
                            <Button x:Name="OpenInExternalButton" Content="{DynamicResource S.Ui.OpenExternal}"
                                    Padding="10,3" Click="OpenInExternalButton_Click"/>
                            <CheckBox x:Name="UseExternalBrowserCheck" VerticalAlignment="Center" Margin="8,0,0,0"
                                      Content="{DynamicResource S.Ui.AlwaysExternal}"
                                      Checked="UseExternalBrowserCheck_Changed" Unchecked="UseExternalBrowserCheck_Changed"/>
                        </ToolBar>
                    </ToolBarTray>
                    <Grid>
                        <wv2:WebView2 x:Name="Browser"/>
                        <Border x:Name="BrowserUnavailablePanel" Background="#FFF8E1"
                                BorderBrush="#E6A817" BorderThickness="1" Padding="12" Visibility="Collapsed">
                            <TextBlock x:Name="BrowserUnavailableText" TextWrapping="Wrap"
                                       Text="{DynamicResource S.Browser.Unavailable}"/>
                        </Border>
                    </Grid>
                </DockPanel>
            </TabItem>
        </TabControl>

        <!-- Barre de statut : ligne DHCP compacte (dépliable) + état permanent de la détection + messages transitoires -->
        <StackPanel Grid.Row="3" Margin="0,10,0,0">
            <!-- Ligne DHCP : compacte par défaut, bouton qui déplie/replie les compteurs détaillés -->
            <DockPanel>
                <Button x:Name="DhcpCountersToggleButton" DockPanel.Dock="Right" Width="26" Padding="0,1"
                        Margin="6,0,0,2" Content="▾" Click="DhcpCountersToggleButton_Click"
                        ToolTip="{DynamicResource S.Ui.DhcpCountersToolTip}"/>
                <TextBlock x:Name="DhcpCompactStatus" Foreground="#444444" TextWrapping="Wrap"
                           Text="{DynamicResource S.Status.DhcpInactive}"/>
            </DockPanel>
            <TextBlock x:Name="DhcpDetailedStatus" Foreground="#888888" TextWrapping="Wrap"
                       Visibility="Collapsed"/>
            <TextBlock x:Name="CaptureStatusText" Foreground="#444444" TextWrapping="Wrap"
                       Text="{DynamicResource S.Status.DetectionNotStarted}"/>
            <DockPanel>
                <TextBlock x:Name="ApipaStatusText" DockPanel.Dock="Right" Foreground="#888888"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="StatusBar" Foreground="#555555" TextWrapping="Wrap"
                           Text="{DynamicResource S.Status.Ready}"/>
            </DockPanel>
        </StackPanel>
    </Grid>
</Window>
